# Agent provider: "claude" (default), "cursor", or "openai"
AGENT_PROVIDER=claude

# Claude Managed Agents
ANTHROPIC_API_KEY=
CLAUDE_AGENT_ID=
CLAUDE_ENVIRONMENT_ID=

# Cursor (when AGENT_PROVIDER=cursor)
# CURSOR_API_KEY=
# CURSOR_REPO_URL=https://github.com/your-org/your-repo
# CURSOR_MODEL=composer-2.5

# OpenAI Agents API (when AGENT_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_AGENT_ID=
# OPENAI_ENVIRONMENT_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Redis
REDIS_URL=

# Optional
# BOT_USERNAME=agent
